# Copy this file to config.env and fill in your keys.
# config.env is listed in .gitignore: never commit real keys.

# ElevenLabs (voice feedback): https://elevenlabs.io -> Profile -> API keys
ELEVENLABS_API_KEY=
# Optional: a different voice (copy a voice ID from the ElevenLabs Voice Library)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Tiger Data (session logging): Tiger Cloud console -> your service -> Connect -> service URL
# Looks like: postgres://tsdbadmin:PASSWORD@xxxx.tsdb.cloud.timescale.com:3xxxx/tsdb?sslmode=require
TIGER_DATABASE_URL=
